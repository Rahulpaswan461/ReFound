{
  "name": "refound",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && rm -rf release && mkdir release && cd dist && zip -qr ../release/refound-$npm_package_version.zip .",
    "store:screens": "npm run build && node scripts/screens.mjs store/screenshots 1280x800"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
