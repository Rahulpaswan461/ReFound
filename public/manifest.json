{
  "manifest_version": 3,
  "name": "ReFound",
  "version": "0.1.1",
  "description": "Rediscover the bookmarks you saved and forgot, every time you open a new tab.",
  "minimum_chrome_version": "116",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "permissions": ["bookmarks", "search", "storage", "unlimitedStorage", "favicon"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
